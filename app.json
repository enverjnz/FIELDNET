{
  "expo": {
    "name": "FIELDNET",
    "slug": "FIELDNET",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fieldnet_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/fieldnet_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.enverjnz.FIELDNET"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fieldnet_logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.enverjnz.FIELDNET"
    },
    "web": {
      "favicon": "./assets/fieldnet_logo.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "fieldnet",
    "extra": {
      "eas": {
        "projectId": "642aec23-08e6-4f95-b78c-7b86dcdda655"
      }
    }
  }
}
